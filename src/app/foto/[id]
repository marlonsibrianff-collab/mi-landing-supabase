import { supabase } from '../../lib/supabase';
import { Fotografia } from '../../types/database';
import Link from 'next/link';
import { notFound } from 'next/navigation';

interface Props {
  params: Promise<{ id: string }>;
}

export default async function FotoDetallePage({ params }: Props) {
  const { id } = await params;

  const { data: foto } = await supabase
    .from('fotografias')
    .select('*')
    .eq('id', id)
    .single();

  if (!foto) {
    notFound();
  }

  const f: Fotografia = foto;

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 p-8">
      <div className="max-w-4xl mx-auto">
        <Link href="/" className="text-teal-400 hover:underline mb-6 inline-block">
          ← Volver al inicio
        </Link>
        <div className="bg-slate-900 rounded-2xl overflow-hidden border border-slate-800">
          <img src={f.url_imagen} alt={f.titulo} className="w-full h-[400px] object-cover" />
          <div className="p-8">
            <span className="text-xs uppercase tracking-widest text-teal-400 font-semibold">
              {f.categoria} • {f.ubicacion}
            </span>
            <h1 className="text-3xl font-bold mt-2 mb-4">{f.titulo}</h1>
            <p className="text-slate-300 text-lg leading-relaxed">{f.descripcion}</p>
          </div>
        </div>
      </div>
    </div>
  );
}
import { supabase } from '../../lib/supabase';
import { Fotografia } from '../../types/database';
import Link from 'next/link';

interface Props {
  params: Promise<{ categoria: string }>;
}

export default async function CategoriaPage({ params }: Props) {
  const { categoria } = await params;

  const { data: fotos } = await supabase
    .from('fotografias')
    .select('*')
    .eq('categoria', categoria);

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 p-8">
      <div className="max-w-6xl mx-auto">
        <Link href="/" className="text-teal-400 hover:underline mb-6 inline-block">
          ← Volver al inicio
        </Link>
        <h1 className="text-4xl font-bold capitalize mb-8">
          Categoría: {categoria}
        </h1>

        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {fotos && fotos.length > 0 ? (
            fotos.map((foto: Fotografia) => (
              <Link
                key={foto.id}
                href={`/foto/${foto.id}`}
                className="bg-slate-900 rounded-xl overflow-hidden border border-slate-800 hover:border-teal-500 transition"
              >
                <img src={foto.url_imagen} alt={foto.titulo} className="w-full h-48 object-cover" />
                <div className="p-4">
                  <h3 className="text-lg font-bold">{foto.titulo}</h3>
                  <p className="text-sm text-slate-400">{foto.ubicacion}</p>
                </div>
              </Link>
            ))
          ) : (
            <p className="text-slate-400">No hay fotos disponibles en esta categoría.</p>
          )}
        </div>
      </div>
    </div>
  );
}